    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.model_selection import GridSearchCV\n",
    "from sklearn.model_selection import cross_val_score\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "%matplotlib inline\n",
    "\n",
    "#print(X_train.shape)\n",
    "#print(y_train.shape)\n",
    "\n",
    "k_range = list(range(1, 30))\n",
    "\n",
    "#Parameters to pass in to the grid\n",
    "param_grid = [{'n_neighbors':[k_range],\n",
    "               'weights':[uniform],\n",
    "               'algorithm':[auto],\n",
    "               'leaf_size':[30],\n",
    "               'p':[2],\n",
    "               'metric':[minkowski],\n",
    "               'metric_params':[None],\n",
    "               'n_jobs':[-1]\n",
    "              }]\n",
    "\n",
    "# instantiating the model\n",
    "knn = KNeighborsClassifier(n_neighbors=k_range)\n",
    "\n",
    "# Using gridsearch with 10-fold corssvalidation (cv=10) with k-range from 1-51\n",
    "print('Training the KNN, this might take some time..')\n",
    "grid = GridSearchCV(knn, param_grid, cv=10, scoring='accuracy')\n",
    "\n",
    "# fit the grid with training data\n",
    "grid.fit(X_train, y_train)\n",
    "\n",
    "# Single best score achieved across all parameters (k)\n",
    "print ('\\n\\033[1mSingel best score within k 1 to 30: \\033[0m \\n{}'.format(grid.best_score_))\n",
    "\n",
    "# Dictionary containing the parameters (k) used to generate that score\n",
    "print (grid.best_params_)\n",
    "\n",
    "# Actual model object fit with those best parameters\n",
    "print ('\\n\\033[1mBest parameters of the KNN are following: \\033[0m \\n{}'.format(grid.best_estimator_))\n",
    "\n",
    "\n",
    "\n",
    "# store scores in scores object\n",
